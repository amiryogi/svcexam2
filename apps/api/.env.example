# Local development settings for the API. Copy to apps/api/.env
NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://svi:svi_dev_password@127.0.0.1:3306/svi_exam
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=0
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
STORAGE_DIR=./storage
# Chrome / Chromium / Edge used for PDF rendering (auto-detected on common paths if empty)
# CHROME_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
LOG_LEVEL=info
