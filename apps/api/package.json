{
  "name": "@svi/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --conditions=development src/scripts/seed.ts",
    "create-admin": "tsx --conditions=development src/scripts/createAdmin.ts",
    "import:access": "tsx --conditions=development src/scripts/importAccess.ts",
    "postinstall": "prisma generate",
    "db:seed:prod": "node dist/scripts/seed.js"
  },
  "dependencies": {
    "@prisma/client": "~6.19.3",
    "@svi/shared": "*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^6.1.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "nepali-date-converter": "^3.4.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "~6.19.3",
    "puppeteer-core": "^25.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
