# Production settings for docker-compose.prod.yml. Copy to .env and fill in.
DOMAIN=exam.example.edu.np

MYSQL_DATABASE=svi_exam
MYSQL_USER=svi
# Use long random values, e.g. `openssl rand -base64 32`
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Encrypts nightly database backups. Store it somewhere safe – backups cannot be restored without it.
BACKUP_PASSPHRASE=
BACKUP_RETENTION_DAYS=30
