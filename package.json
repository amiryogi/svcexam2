{
  "name": "svi-exam-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run dev -w @svi/api",
    "dev:web": "npm run dev -w @svi/web",
    "build": "npm run build -w @svi/shared && npm run build -w @svi/api && npm run build -w @svi/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "npm run db:migrate -w @svi/api",
    "db:seed": "npm run db:seed -w @svi/api",
    "create-admin": "npm run create-admin -w @svi/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
